PORT=3000
POSTGRES_PORT=5432

MOODLE_LOGIN=moodle-login
FULL_NAME=author-name

# Generate with: openssl rand -hex 32
# Changing this value immediately revokes every previously issued JWT.
JWT_SECRET=jwt-signing-secret-change-me-at-least-32-characters

POSTGRES_DB=todo
POSTGRES_ADMIN_USER=todo_admin
POSTGRES_ADMIN_PASSWORD=admin-pass

POSTGRES_APP_USER=todo_app
POSTGRES_APP_PASSWORD=app-password-change-me

POSTGRES_TEACHER_USER=todo_teacher
POSTGRES_TEACHER_PASSWORD=teacher-password

DATABASE_URL=postgresql://todo_app:app-password-change-me@127.0.0.1:5432/todo
DATABASE_SSL=false
